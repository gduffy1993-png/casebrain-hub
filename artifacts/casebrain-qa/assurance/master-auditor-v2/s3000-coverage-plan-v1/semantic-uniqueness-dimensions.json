    },
    "disclosure_multi_defendant_procedural": {
      "homeQuota": 450,
      "documentGraphLargestClusterMaxShare": 0.12,
      "evidenceGraphLargestClusterMaxShare": 0.1,
      "combinedSemanticSignatureLargestClusterMaxShare": 0.007,
      "combinedSemanticSignatureTargetUniqueRate": 1.0,
      "chargeFamilyLargestClusterMaxShare": 0.28,
      "publicFormStructureLargestClusterMaxShare": 1.0,
      "defencePositionLargestClusterMaxShare": 0.35,
      "proceduralStageLargestClusterMaxShare": 0.32,
      "documentLayoutLargestClusterMaxShare": 0.28,
