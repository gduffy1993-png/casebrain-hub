      "combinedSemanticSignatureTargetUniqueRate": 1.0,
      "chargeFamilyLargestClusterMaxShare": 0.3,
      "publicFormStructureLargestClusterMaxShare": 1.0,
      "defencePositionLargestClusterMaxShare": 0.4,
      "proceduralStageLargestClusterMaxShare": 0.35,
      "documentLayoutLargestClusterMaxShare": 0.25,
      "evidenceStateLabelLargestClusterMaxShare": 0.35
    },
    "bail_sentencing_newton_appeal_unusual": {
      "homeQuota": 300,
      "documentGraphLargestClusterMaxShare": 0.14,
      "evidenceGraphLargestClusterMaxShare": 0.12,
      "combinedSemanticSignatureLargestClusterMaxShare": 0.01,
      "combinedSemanticSignatureTargetUniqueRate": 1.0,
      "chargeFamilyLargestClusterMaxShare": 0.3,
      "publicFormStructureLargestClusterMaxShare": 1.0,
      "defencePositionLargestClusterMaxShare": 0.35,
      "proceduralStageLargestClusterMaxShare": 0.35,
      "documentLayoutLargestClusterMaxShare": 0.3,
      "evidenceStateLabelLargestClusterMaxShare": 0.35
    }
  },
  "dimensions": [
    {
      "id": "case_identity",
      "layer": "L1",
      "requiredUnique": true,
      "includes": ["caseId", "packetHash"]
    },
    {
      "id": "complete_source_and_output",
      "layer": "L1",
      "requiredUnique": true,
      "includes": ["completeSourceFingerprint", "completeOutputFingerprint"]
    },
    {
      "id": "combined_semantic_signature",
      "layer": "L2",
      "requiredUnique": "normally_yes_target_rate_1",
      "requiredUniqueFalseFor": ["ids", "names", "dates", "salts", "cosmetic_wording"]
    },
    {
      "id": "document_graph",
      "layer": "L6",
      "requiredUnique": false,
      "dominanceCapped": true,
      "includes": [
        "which_documents_exist",
        "missing_referred_partial_edges",
        "index_vs_body_consistency",
        "supersession_edges",
        "exhibit_label_graph",
        "cross_defendant_document_ownership"
      ]
    },
    {
      "id": "evidence_graph",
      "layer": "L6",
      "requiredUnique": false,
      "dominanceCapped": true,
      "includes": [
        "per_exhibit_service_state",
        "reliability_contested_flags",
        "later_disclosure_waves",
        "truth_keyed_absences"
      ]
    },
    {
      "id": "charge_family",
      "layer": "L3",
      "requiredUnique": false
    },
    {
      "id": "document_layout",
      "layer": "L3",
      "requiredUnique": false
    },
    {
      "id": "defence_position",
      "layer": "L3",
      "requiredUnique": false
    },
    {
      "id": "procedural_stage",
      "layer": "L3",
      "requiredUnique": false
    },
    {
      "id": "evidence_state_label",
      "layer": "L3",
      "requiredUnique": false
    },
    {
      "id": "public_form_structure",
      "layer": "L4",
      "requiredUnique": false,
      "mustNotBeRejectedForRepetition": true
    },
    {
      "id": "universal_safety_wording",
      "layer": "L5",
      "requiredUnique": false,
      "measuredSeparately": true
    },
    {
      "id": "primary_stratum_and_complexity_cell",
      "requiredUnique": false,
      "note": "Many cases share a stratum×tier cell by design."
    }
  ],
  "clusterRejectionTriggers": [
    "duplicate caseId, packetHash, completeSourceFingerprint, or completeOutputFingerprint",
    "identical combinedSemanticSignature after normalisation",
    "parameter-substitution clone (same substantive combination; only names/dates/IDs/salts differ)",
    "cosmetic_uniqueness_rejection detector hit",
    "documentGraph or evidenceGraph dominance share exceeds stratum cap",
    "combinedSemanticSignature dominance share exceeds stratum cap",
    "trap-axis remix on an unchanged matter skeleton without new substantive-axis delta",
    "layout-only mutation that does not change any truth-key, evidence-state, absence, or expected-behaviour assertion"
  ],
  "notRejectionTriggers": [
    "shared charge family",
    "shared document layout class",
    "shared defence position",
    "shared procedural stage",
    "shared evidence-state label",
    "repeated official/public form structures",
    "repeated universal safety wording",
    "shared document-graph within stratum dominance cap",
    "shared evidence-graph within stratum dominance cap"
  ],
  "cosmeticUniquenessRejectionDetectorRef": "cosmetic-uniqueness-rejection-detector.json",
  "routine600StructureSharingProofRef": "routine-600-structure-sharing-proof.json",
  "beforeAfterPolicyRef": "semantic-uniqueness-before-after.json",
  "validationContractRef": "semantic-uniqueness-validation-contract.json",
  "reportingRequiredAtFutureSelection": [
    "L1 uniqueness counts (must equal population)",
    "combinedSemanticSignature unique rate and largest cluster share by stratum",
    "documentGraph and evidenceGraph largest cluster shares by stratum",
    "individual dimension cluster histograms (charge/layout/defence/stage/evidence/form)",
    "public form repetition counts (informational, not reject)",
    "safety wording repetition report (separate)",
    "cosmetic uniqueness rejection detector hits",
    "rejectedSubstitutionAttempts count",
    "nearest-neighbour substantive axis delta distribution"
  ]
}
