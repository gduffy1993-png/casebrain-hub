{
  "schemaVersion": "s3000-semantic-uniqueness-dimensions@1.1.0",
  "locked": true,
  "policyRevision": "layered-uniqueness-v1",
  "supersedes": "s3000-semantic-uniqueness-dimensions@1.0.0",
  "casesSelectedOrGenerated": false,
  "purpose": "Layered semantic uniqueness: hard identity uniqueness where required; allow legitimate single-dimension and public-form clustering; forbid manufactured diversity via IDs, salts or cosmetic wording.",
  "blanketClusterMaxOne": {
    "status": "withdrawn",
    "reason": "Too strict; incentivised ID/salt/cosmetic wording churn to force artificial uniqueness."
  },
  "layers": {
    "L1_hardIdentity": {
      "title": "Hard identity — zero duplicates allowed",
      "zeroDuplicatesAllowed": [
        "caseId",
        "packetHash",
        "completeSourceFingerprint",
        "completeOutputFingerprint"
      ],
      "note": "These are packet/identity hashes, not semantic similarity scores."
    },
    "L2_combinedSemanticSignature": {
      "title": "Complete combined semantic case signature",
      "mustNormallyBeUnique": true,
      "targetUniqueRate": 1.0,
      "mustNotContributeToUniqueness": [
        "caseId",
        "personNames",
        "dates",
        "salts",
        "generatorTokens",
        "cosmeticWordingVariants",
        "whitespacePunctuationOnly",
        "synonymReskinWithoutFactChange"
      ],
      "builtFromNormalised": [
        "factsCore",
        "partiesAttributionGraph",
        "evidenceStates",
        "contradictionsChronology",
        "documentRelationships",
        "procedurePrimary",
        "defencePrimary",
        "missingMaterialTruthKeyed",
        "expectedCaseBrainBehaviourContract"
      ],
      "exactDuplicateCombinedSignature": "hard_reject",
      "dominanceCaps": "see dominanceCapsByStratum.combinedSemanticSignature"
    },
    "L3_individualDimensionsMayCluster": {
      "title": "Individual dimensions may legitimately cluster",
      "mayClusterFreelyOrUnderSoftCaps": [
        "chargeFamily",
        "documentLayout",
        "defencePosition",
        "proceduralStage",
        "evidenceState",
        "publicFormStructure"
      ],
      "requiredUnique": false,
      "note": "Sharing a charge family, layout, defence, stage, evidence-state label, or public form is expected and not a duplicate by itself."
    },
    "L4_publicOfficialForms": {
      "title": "Repeated official/public form structures",
      "expected": true,
      "mustNotBeRejected": true,
      "examples": [
        "MG05",
        "MG06",
        "MG11",
        "written_charge",
        "bail_notice",
        "PTPH_form_structure",
        "unused_schedule_template"
      ]
    },
    "L5_universalSafetyWording": {
      "title": "Universal safety wording",
      "mayRepeat": true,
      "measuredSeparatelyFromSubstantiveOutput": true,
      "examples": [
        "audience_safety_disclaimers",
        "privilege_withholding_boilerplate",
        "uncertainty_qualification_stock_phrases",
        "referral_only_safe_language"
      ],
      "reporting": "safetyWordingRepetitionReport — never used as substantive uniqueness credit or debit"
    },
    "L6_graphDominanceCaps": {
      "title": "Document-graph, evidence-graph, combined-signature dominance",
      "notBlanketMaxOne": true,
      "caps": "dominanceCapsByStratum"
    },
    "L7_meaningfulDistinctness": {
      "title": "A case counts as meaningfully distinct only via substantive combinations",
      "requiredCombinationAxes": [
        "facts",
        "partiesAttribution",
        "evidenceStates",
        "contradictions",
        "documentRelationships",
        "procedure",
        "defence",
        "missingMaterial",
        "expectedCaseBrainBehaviour"
      ],
      "minimumDistinctAxesVsNearestNeighbour": 2,
      "note": "At least two of the required axes must differ in a truth-keyed way versus the nearest neighbour after normalisation."
    }
  },
  "normalisationBeforeCombinedSignature": [
    "lowercase",
    "strip case IDs and generator salts",
    "strip dates and order indices",
    "replace person names with <NAME>",
    "replace addresses/phones/emails with typed placeholders",
    "strip cosmetic synonym reskins that do not change facts",
    "do not treat layout noise alone as signature input unless it creates a truth-keyed evidence-state or absence assertion",
    "SHA-256 of normalised substantive payload = combinedSemanticSignature"
  ],
  "dominanceCapsByStratum": {
    "unit": "largest_cluster_size / stratum_home_count",
    "note": "Caps apply inside each primaryStratumHome. Combined-signature target remains full uniqueness; the cap is a fail-closed dominance brake if any collision slips through review.",
    "routine_volume": {
      "homeQuota": 600,
      "documentGraphLargestClusterMaxShare": 0.18,
      "evidenceGraphLargestClusterMaxShare": 0.15,
      "combinedSemanticSignatureLargestClusterMaxShare": 0.005,
      "combinedSemanticSignatureTargetUniqueRate": 1.0,
      "chargeFamilyLargestClusterMaxShare": 0.35,
      "publicFormStructureLargestClusterMaxShare": 1.0,
      "defencePositionLargestClusterMaxShare": 0.45,
      "proceduralStageLargestClusterMaxShare": 0.4,
      "documentLayoutLargestClusterMaxShare": 0.35,
      "evidenceStateLabelLargestClusterMaxShare": 0.4
    },
    "serious_violence_sexual": {
      "homeQuota": 600,
      "documentGraphLargestClusterMaxShare": 0.12,
      "evidenceGraphLargestClusterMaxShare": 0.12,
      "combinedSemanticSignatureLargestClusterMaxShare": 0.005,
      "combinedSemanticSignatureTargetUniqueRate": 1.0,
      "chargeFamilyLargestClusterMaxShare": 0.25,
      "publicFormStructureLargestClusterMaxShare": 1.0,
      "defencePositionLargestClusterMaxShare": 0.35,
      "proceduralStageLargestClusterMaxShare": 0.3,
